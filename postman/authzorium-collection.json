{
  "info": {
    "_postman_id": "authzorium-collection-20260119",
    "name": "Authzorium API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for all Authzorium API endpoints."
  },
  "item": [
    {
      "name": "Find User by Username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/findByUsername/{{userName}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "findByUsername", "{{userName}}"]
        }
      }
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sampleuser\",\n  \"displayName\": \"Sample User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "Get All Pets of User (JPA pageable)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userName}}/pets?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userName}}", "pets"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "Get All Pets of User (Blaze pageable)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userName}}/pets-blaze?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userName}}", "pets-blaze"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" }
          ]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userName", "value": "demo-user" },
    { "key": "userId", "value": "1" }
  ]
}
