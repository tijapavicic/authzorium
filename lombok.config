# Lombok configuration for this project (root)
# Prevent this config from 'bubbling up' to parent directories
config.stopBubbling = true

# Add @lombok.Generated annotation to generated members (helps coverage tools)
lombok.addLombokGeneratedAnnotation = true

# Make anyConstructor add @ConstructorProperties where appropriate (helps frameworks)
lombok.anyConstructor.addConstructorProperties = true

# Treat common JPA annotations as copyable so Lombok-generated constructors/getters keep them
lombok.copyableAnnotations += javax.persistence.Entity
lombok.copyableAnnotations += javax.persistence.MappedSuperclass
lombok.copyableAnnotations += javax.persistence.Embeddable

# Default: don't change, but allow IDEs to pick up
# Note: enable annotation processing in your IDE (IntelliJ/Eclipse) to see generated members.

